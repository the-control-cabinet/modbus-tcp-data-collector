[
  {
    "id": "example-modbus-flow",
    "type": "tab",
    "label": "Modbus TCP Collector",
    "disabled": false,
    "info": "Example flow – import into Node-RED after installing node-red-contrib-modbus"
  },
  {
    "id": "modbus-client-1",
